{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["/absolute/trusted/will/hook.mjs"],
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
